# Trên server: sao chép thành .env rồi điền. Không commit file .env.
ANTHROPIC_API_KEY=
# Token của Cloudflare Tunnel (docs/deploy.md)
TUNNEL_TOKEN=
# Mã mở khi vào trang chủ; đổi thì phải build lại
NEXT_PUBLIC_DEFAULT_SYMBOL=HPG
# Cảnh báo Telegram, chạy trên máy cá nhân (docs/alerts.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 0: không báo gần đạt
WYCKOFF_ALERT_NEAR=1
